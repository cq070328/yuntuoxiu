<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="云脱修"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvShizuku"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Shizuku 状态检查中..."
        android:textSize="13sp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnGrantShizuku"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:text="授权 Shizuku" />

        <Button
            android:id="@+id/btnPickApk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:text="选择 APK" />

        <Button
            android:id="@+id/btnStartWorker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:text="启动 Worker" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTaskCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="任务列表（0）"
        android:textSize="14sp"
        android:textStyle="bold"
        android:paddingTop="12dp"
        android:paddingBottom="4dp" />

    <!-- 任务列表（占上半部分） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3" />

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#333333"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp" />

    <!-- 运行日志（内嵌，任务列表下方，实时滚动） -->
    <TextView
        android:id="@+id/tvLogHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="运行日志（实时）"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#58A6FF" />

    <ScrollView
        android:id="@+id/svLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:paddingTop="2dp"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="等待日志..."
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textColor="#A0A0A0" />
    </ScrollView>

</LinearLayout>