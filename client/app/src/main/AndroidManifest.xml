<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Shizuku 授权 -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- 读写公共工作区（Operit 公共工作区） -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- 安装 / 卸载 APK（Shizuku 权限下） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- 与 Termux 联动：允许 Termux 执行命令 -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- Android 11+ 查询 Termux（包可见性）。
         注意：RUN_COMMAND 的目标 Service 必须能被显式解析，
         同时也要声明 service 的 package 查询，否则部分 ROM 上
         startService 会报 "not found"。 -->
    <queries>
        <package android:name="com.termux" />
        <intent>
            <action android:name="com.termux.RUN_COMMAND" />
        </intent>
    </queries>

    <!-- Worker 前台服务：
         ⚠️ Android 14 (targetSdk 34) 要求：
           声明了 service 的 foregroundServiceType 就必须同时声明对应权限，
           否则 startForeground 会抛 SecurityException 崩溃。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".YunTuoXiuApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.UnpackCloud"
        tools:targetApi="31">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.TaskDetailActivity"
            android:exported="false" />

        <!-- foregroundServiceType 与 FOREGROUND_SERVICE_DATA_SYNC 权限配套 -->
        <service
            android:name=".worker.WorkerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Shizuku Provider -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- ⭐ v1.8.3 关键修复：Shizuku UserService 必须在此声明！
             ----------------------------------------------------------
             根因：此前 Manifest 未声明本 Service，导致
               Shizuku.bindUserService() 找不到目标 → 无法用 shell uid 拉起
               → onServiceConnected 永不回调 → bound 永远 false
               → 所有 Shizuku 操作报 ERR_SERVICE_NOT_BOUND(-1003)
               → CLEAR_TARGET/INSTALL_CLONE/START_TARGET 全失败
               → dump 无产出 → 一键脱修卡在「5/7 等待 dump」。

             说明：
               · process=":shizuku" 对应
                 UserServiceArgs.processNameSuffix("shizuku")
               · exported=false：Shizuku 通过内部机制绑定，无需导出 -->
        <service
            android:name=".shizuku.YunTuoXiuUserService"
            android:exported="false"
            android:process=":shizuku" />

        <!-- ⭐ v1.6.4 FileProvider：任务详情页「一键安装」用系统安装器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:enabled="true"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>